--==============================================================
-- MOVE MODEL
--==============================================================

local function moveModelTo(target)

    if not target
        or not target.Parent then

        return true
    end

    local StartPivot =
        Figure:GetPivot()

    local TargetPosition =
        target.Position
        + MOVEMENT_OFFSET

    local Distance =
        (
            StartPivot.Position
            - TargetPosition
        ).Magnitude

    local TravelTime =
        math.max(
            Distance / SPEED,
            0.03
        )

    local StartTime =
        time()

    while true do

        if not Figure
            or not Figure.Parent then

            return false
        end

        if KillTriggered then
            return false
        end

        local Alpha =
            math.clamp(
                (
                    time()
                    - StartTime
                )
                / TravelTime,
                0,
                1
            )

        local NewPos =
            StartPivot.Position:Lerp(
                TargetPosition,
                Alpha
            )

        Figure:PivotTo(
            CFrame.new(
                NewPos
            )
            * StartPivot.Rotation
        )

        if Alpha >= 1 then
            break
        end

        RunService.Heartbeat:Wait()

    end

    return true

end

--==============================================================
-- MOVE THROUGH TARGETS
--==============================================================

local function moveThroughTargets(list)

    for _, target in ipairs(
        list
    ) do

        if KillTriggered then
            return false
        end

        if not moveModelTo(
            target
        ) then

            return false

        end

    end

    return true

end

