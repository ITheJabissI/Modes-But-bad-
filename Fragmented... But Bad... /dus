local function getRooms()

    local rooms = {}

    for _, room in ipairs(
        RoomsFolder:GetChildren()
    ) do

        local number =
            tonumber(
                room.Name
            )

        if number then

            table.insert(
                rooms,
                room
            )

        end

    end

    table.sort(
        rooms,
        function(a, b)

            return tonumber(a.Name)
                < tonumber(b.Name)

        end
    )

    return rooms

end

