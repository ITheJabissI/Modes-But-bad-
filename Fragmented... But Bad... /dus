local function getLights(room)

    local lights = {}

    for _, obj in ipairs(
        room:GetDescendants()
    ) do

        if obj:IsA("PointLight")
            or obj:IsA("SpotLight")
            or obj:IsA("SurfaceLight") then

            table.insert(
                lights,
                obj
            )

        end

    end

    return lights

end

local function flickerLights(room)

    if not FLICKER_LIGHTS then
        return
    end

    local lights =
        getLights(room)

    local original = {}

    for _, light in ipairs(
        lights
    ) do

        original[light] =
            light.Enabled

    end

    local startTime =
        time()

    while time()
        - startTime
        < FLICKER_DURATION do

        for _, light in ipairs(
            lights
        ) do

            if light
                and light.Parent then

                light.Enabled =
                    math.random(
                        1,
                        2
                    ) == 1

            end

        end

        task.wait(
            FLICKER_SPEED
        )

    end

    for _, light in ipairs(
        lights
    ) do

        if light
            and light.Parent then

            light.Enabled =
                original[light]

        end

    end

end

