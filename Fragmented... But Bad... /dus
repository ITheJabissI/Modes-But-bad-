    and not KillTriggered
    and REBOUNDS > 0 then

    for rebound = 1,
        REBOUNDS do

        if KillTriggered then
            break
        end

        task.wait(
            REBOUND_DELAY
        )

        local ReverseTargets = {}

        for i =
            #Targets,
            1,
            -1 do

            table.insert(
                ReverseTargets,
                Targets[i]
            )

        end

        local reverseCompleted =
            moveThroughTargets(
                ReverseTargets
            )

        if not reverseCompleted then
            break
        end

        if rebound < REBOUNDS
            and not KillTriggered then

            task.wait(
                REBOUND_DELAY
            )

            local forwardCompleted =
                moveThroughTargets(
                    Targets
                )

            if not forwardCompleted then
                break
            end

        end

    end

end

