--==============================================================
-- GITHUB RBXM LOADER
--==============================================================

local function loadGitHubRBXM(url)

    print("======================================")
    print("Downloading RBXM:")
    print(url)
    print("======================================")

    local ok, data =
        pcall(function()

            return game:HttpGet(url)

        end)

    if not ok then

        warn(
            "HTTP DOWNLOAD FAILED:"
        )

        warn(data)

        return nil
    end

    if not data
        or #data == 0 then

        warn(
            "GitHub returned empty data."
        )

        return nil
    end

    print(
        "RBXM downloaded."
    )

    print(
        "Bytes:",
        #data
    )

    --==========================================================
    -- SERIALIZATION SERVICE
    --==========================================================

    local SerializationService =
        game:GetService(
            "SerializationService"
        )

    if not SerializationService then

        warn(
            "SerializationService is unavailable."
        )

        return nil
    end

    --==========================================================
    -- BUFFER
    --==========================================================

    local bufferOK,
        bufferResult =
        pcall(function()

            return buffer.fromstring(
                data
            )

        end)

    if not bufferOK then

        warn(
            "Could not convert RBXM data to buffer:"
        )

        warn(bufferResult)

        return nil
    end

    --==========================================================
    -- DESERIALIZE
    --==========================================================

    local deserializeOK,
        objects =
        pcall(function()

            return SerializationService:
                DeserializeInstancesAsync(
                    bufferResult
                )

        end)

    if not deserializeOK then

        warn(
            "RBXM DESERIALIZATION FAILED:"
        )

        warn(objects)

        return nil
    end

    if not objects
        or #objects == 0 then

        warn(
            "RBXM deserialized but returned no Instances."
        )

        return nil
    end

    local root

    for _, object in ipairs(
        objects
    ) do

        if object:IsA("Model") then

            root = object

            break

        end

    end

    if not root then
        root = objects[1]
    end

    if not root then
        return nil
    end

    return root

end

--==============================================================
-- ROBLOX ASSET LOADER
--==============================================================

local function loadRobloxAsset(asset)

    local ok, objects =
        pcall(function()

            return game:GetObjects(
                asset
            )

        end)

    if not ok then

        warn(
            "ROBLOX ASSET LOAD FAILED:"
        )

        warn(objects)

        return nil
    end

    if not objects
        or #objects == 0 then

        warn(
            "Roblox asset returned no objects."
        )

        return nil
    end

    return objects[1]

end

--==============================================================
-- UNIVERSAL LOADER
--==============================================================

local function loadEntity(asset)

    if asset:match("^https://")
        or asset:match("^http://") then

        return loadGitHubRBXM(
            asset
        )

    elseif asset:match(
        "^rbxassetid://"
    ) then

        return loadRobloxAsset(
            asset
        )

    end

    warn(
        "Unsupported asset:",
        asset
    )

    return nil

end

